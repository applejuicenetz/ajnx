package view

// LoginPage rendert die Login-Seite – kein Sidebar, kein Nav (analog zum Setup-Layout).
// errorMsg ist leer wenn kein Fehler vorliegt.
// welcome=true zeigt eine Willkommensnachricht nach dem ersten Setup.
templ LoginPage(errorMsg string, welcome bool) {
	<!DOCTYPE html>
	<html lang="de" class="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>Anmelden – AJNX</title>
			<link rel="stylesheet" href="/static/tailwind.css"/>
		</head>
		<body class="bg-background text-text-main font-sans antialiased min-h-screen flex items-center justify-center">
			<div class="w-full max-w-sm px-6">
				<!-- Logo -->
				<div class="mb-8 flex flex-col items-center">
					<span class="text-primary">
						@Logo("w-12 h-14")
					</span>
					<span class="mt-3 text-2xl font-bold tracking-tight">ajnx</span>
					<span class="text-xs text-text-muted mt-1">AppleJuice Network eXperience</span>
				</div>

				<!-- Willkommensmeldung nach Setup -->
				if welcome {
					<div class="mb-4 rounded-lg bg-status-ok/10 border border-status-ok/30 px-4 py-3 text-sm text-status-ok">
						Setup abgeschlossen. Bitte melde dich an.
					</div>
				}

				<!-- Fehlermeldung -->
				if errorMsg != "" {
					<div class="mb-4 rounded-lg bg-status-err/10 border border-status-err/30 px-4 py-3 text-sm text-status-err">
						{ errorMsg }
					</div>
				}

				<!-- Login-Formular -->
				<div class="bg-surface rounded-xl border border-border p-8 shadow-2xl">
					<h1 class="text-lg font-semibold mb-6">Anmelden</h1>
					<form method="POST" action="/login" class="space-y-4">
						<div>
							<label for="password" class="block text-sm text-text-muted mb-1">Core-Passwort</label>
							<input
								id="password"
								name="password"
								type="password"
								autocomplete="current-password"
								required
								autofocus
								class="w-full px-3 py-2 rounded-lg bg-background border border-border text-text-main placeholder-text-muted focus:outline-none focus:ring-2 focus:ring-primary/50 focus:border-primary transition"
								placeholder="Passwort eingeben"
							/>
						</div>
						<button
							type="submit"
							class="w-full py-2 px-4 rounded-lg bg-primary text-white font-semibold hover:bg-primary/90 transition"
						>
							Anmelden
						</button>
					</form>
				</div>
			</div>
		</body>
	</html>
}
