package view

import (
	"github.com/applejuicenetz/ajnx/internal/domain"
	"fmt"
)

templ DownloadsPage(downloads []domain.Download, nickname string) {
	@Layout("Downloads", "downloads", nickname) {
		<div class="space-y-4">
			<!-- Page Header -->
			<div class="flex items-center justify-between">
				<h2 class="text-3xl font-bold">
					Downloads ({ fmt.Sprint(len(downloads)) })
				</h2>
				<button 
					hx-post="/downloads/clean" 
					hx-swap="none"
					class="flex items-center gap-2 bg-surface border border-border hover:border-primary hover:text-primary px-4 py-2 rounded-lg transition-all text-sm font-bold shadow-sm"
				>
					<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 6v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
					Liste bereinigen
				</button>
			</div>

			<!-- Desktop: Tabelle -->
			<div class="hidden lg:block overflow-x-auto rounded-lg border border-border">
				<table class="w-full text-sm">
					<thead>
						<tr class="bg-surface text-text-muted text-xs uppercase tracking-wider border-b border-border">
							<th class="px-4 py-3 text-left w-10">
								<input type="checkbox" class="rounded border-border bg-background"/>
							</th>
							<th class="px-4 py-3 text-left">Dateiname / Quellen</th>
							<th class="px-4 py-3 text-left w-24">Größe</th>
							<th class="px-4 py-3 text-left w-32">Status</th>
							<th class="px-4 py-3 text-left w-36">Fortschritt</th>
							<th class="px-4 py-3 text-left w-24">Speed</th>
							<th class="px-4 py-3 text-left w-20">ETA</th>
							<th class="px-4 py-3 text-right w-24">Aktionen</th>
						</tr>
					</thead>
					<tbody id="downloads-body" hx-get="/partials/downloads-list" hx-trigger="every 3s, refreshDownloads from:body" hx-swap="innerHTML">
						@DownloadRows(downloads)
					</tbody>
				</table>
			</div>

			<!-- Mobile: Cards -->
			<div class="lg:hidden space-y-3" id="downloads-cards" hx-get="/partials/downloads-cards" hx-trigger="every 3s, refreshDownloads from:body" hx-swap="innerHTML">
				@DownloadCards(downloads)
			</div>
		</div>
	}
}

// DownloadRows ist der htmx-Partial für den <tbody> (Desktop).
templ DownloadRows(downloads []domain.Download) {
	if len(downloads) == 0 {
		<tr>
			<td colspan="8" class="px-4 py-16 text-center text-text-muted">
				<div class="flex flex-col items-center gap-3 opacity-50">
					<svg class="w-12 h-12" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
					<p class="text-sm">Keine aktiven Downloads — füge einen AJ-Link hinzu</p>
				</div>
			</td>
		</tr>
	}
	for _, d := range downloads {
		<tr class="group border-b border-border hover:bg-gray-800/50 transition-colors">
			<!-- Checkbox -->
			<td class="px-4 py-4 align-middle">
				<input type="checkbox" class="rounded border-border bg-background"/>
			</td>
			<!-- Dateiname -->
			<td class="px-4 py-4 align-middle max-w-xs">
				<span class="truncate block font-medium" title={ d.Filename }>{ d.Filename }</span>
				<div class="flex items-center gap-2 mt-1">
					<span class="text-[10px] text-text-muted bg-surface px-1.5 py-0.5 rounded border border-border">
						Quellen: { fmt.Sprintf("%d/%d", countActiveSources(d.Sources), len(d.Sources)) }
					</span>
					if pos := getBestQueuePosition(d.Sources); pos > 0 {
						<span class="text-[10px] text-status-warn bg-status-warn/5 px-1.5 py-0.5 rounded border border-status-warn/20">
							Warteschlange: { fmt.Sprint(pos) }
						</span>
					}
				</div>
			</td>
			<!-- Größe -->
			<td class="px-4 py-4 align-middle text-text-muted whitespace-nowrap">
				{ formatSize(d.Size) }
			</td>
			<!-- Status -->
			<td class={ "px-4 py-4 align-middle whitespace-nowrap font-medium " + dlStatusClass(d) }>
				{ dlStatusLabel(d) }
			</td>
			<!-- Progress Bar -->
			<td class="px-4 py-4 align-middle">
				<div class="bg-gray-700 rounded-full h-2.5 w-full">
					<div
						class={ "h-2.5 rounded-full transition-all duration-500 " + dlProgressBarClass(d) }
						style={ fmt.Sprintf("width: %.0f%%", d.ProgressPercent) }
					></div>
				</div>
				<p class="text-xs text-text-muted mt-1 text-center">{ fmt.Sprintf("%.0f%%", d.ProgressPercent) }</p>
			</td>
			<!-- Speed -->
			<td class="px-4 py-4 align-middle text-text-muted whitespace-nowrap">
				{ formatSpeed(d.SpeedBps) }
			</td>
			<!-- ETA -->
			<td class="px-4 py-4 align-middle text-text-muted whitespace-nowrap">
				{ formatETA(d.EtaSeconds) }
			</td>
			<!-- Aktionen (sichtbar nur bei hover via group) -->
			<td class="px-4 py-4 align-middle">
				<div class="flex items-center justify-end gap-1 opacity-0 group-hover:opacity-100 transition-opacity">
					if d.Status == domain.DownloadPaused {
						<!-- Resume -->
						<form hx-post={ string(templ.SafeURL("/downloads/" + d.ID + "/resume")) } hx-swap="none">
							<button type="submit" class="p-1.5 text-text-muted hover:text-primary transition-colors rounded" title="Fortsetzen">
								<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
							</button>
						</form>
					} else {
						<!-- Pause -->
						<form hx-post={ string(templ.SafeURL("/downloads/" + d.ID + "/pause")) } hx-swap="none">
							<button type="submit" class="p-1.5 text-text-muted hover:text-primary transition-colors rounded" title="Pausieren">
								<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
							</button>
						</form>
					}
					<!-- Cancel -->
					<form hx-post={ string(templ.SafeURL("/downloads/" + d.ID + "/cancel")) } hx-swap="none" hx-confirm="Download wirklich abbrechen?">
						<button type="submit" class="p-1.5 text-text-muted hover:text-status-err transition-colors rounded" title="Abbrechen">
							<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
						</button>
					</form>
				</div>
			</td>
		</tr>
	}
}

// DownloadCards ist der htmx-Partial für die Mobile-Card-Liste.
templ DownloadCards(downloads []domain.Download) {
	if len(downloads) == 0 {
		<div class="flex flex-col items-center justify-center py-16 text-text-muted opacity-50 gap-3">
			<svg class="w-12 h-12" fill="none" stroke="currentColor" stroke-width="1" viewBox="0 0 24 24"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
			<p class="text-sm">Keine aktiven Downloads — füge einen AJ-Link hinzu</p>
		</div>
	}
	for _, d := range downloads {
		<div class="bg-surface rounded-lg p-4 border border-border">
			<!-- Header: Titel + Menü -->
			<div class="flex items-start justify-between gap-2 mb-3">
				<p class="font-medium text-sm leading-tight break-all">{ d.Filename }</p>
				<div class="flex gap-1 shrink-0">
					if d.Status == domain.DownloadPaused {
						<form hx-post={ string(templ.SafeURL("/downloads/" + d.ID + "/resume")) } hx-swap="none">
							<button type="submit" class="p-1.5 text-text-muted hover:text-primary transition-colors" title="Fortsetzen">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><polygon points="5 3 19 12 5 21 5 3"/></svg>
							</button>
						</form>
					} else {
						<form hx-post={ string(templ.SafeURL("/downloads/" + d.ID + "/pause")) } hx-swap="none">
							<button type="submit" class="p-1.5 text-text-muted hover:text-primary transition-colors" title="Pausieren">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><rect x="6" y="4" width="4" height="16"/><rect x="14" y="4" width="4" height="16"/></svg>
							</button>
						</form>
					}
					<form hx-post={ string(templ.SafeURL("/downloads/" + d.ID + "/cancel")) } hx-swap="none" hx-confirm="Download wirklich abbrechen?">
						<button type="submit" class="p-1.5 text-text-muted hover:text-status-err transition-colors" title="Abbrechen">
							<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" viewBox="0 0 24 24"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
						</button>
					</form>
				</div>
			</div>
			<!-- Progress Bar -->
			<div class="bg-gray-700 rounded-full h-2.5 mb-3">
				<div
					class={ "h-2.5 rounded-full transition-all duration-500 " + dlProgressBarClass(d) }
					style={ fmt.Sprintf("width: %.0f%%", d.ProgressPercent) }
				></div>
			</div>
			<!-- Metriken -->
			<div class="flex items-center justify-between text-xs text-text-muted">
				<span class={ "font-medium " + dlStatusClass(d) }>{ dlStatusLabel(d) }</span>
				<span>{ formatSize(d.Size) }</span>
				<span>{ formatSpeed(d.SpeedBps) }</span>
				<span>ETA: { formatETA(d.EtaSeconds) }</span>
			</div>
		</div>
	}
}

// ─── Hilfsfunktionen ────────────────────────────────────────────────────────

func dlStatusLabel(d domain.Download) string {
	switch d.Status {
	case domain.DownloadPaused:
		return "Pausiert"
	case domain.DownloadFinishing:
		return "Fertigstellen"
	case domain.DownloadFinished:
		return "Fertig"
	case domain.DownloadCanceled:
		return "Abgebrochen"
	case domain.DownloadCanceling:
		return "Abbrechen..."
	case domain.DownloadDiskFull:
		return "Kein Speicher"
	case domain.DownloadFinishError:
		return "Fehler"
	case domain.DownloadCreatingData:
		return "Schreibe..."
	}
	
	// Check sources for transferring or queue
	hasTransferring := false
	hasOwnLimit := false
	bestPos := 0

	for _, src := range d.Sources {
		if src.Status == domain.UserTransferring {
			hasTransferring = true
			break
		}
		if src.Status == domain.UserOwnLimit {
			hasOwnLimit = true
		}
		if src.Status == domain.UserInQueue {
			if bestPos == 0 || src.QueuePosition < bestPos {
				bestPos = src.QueuePosition
			}
		}
	}

	if hasTransferring {
		return "Übertragen"
	}
	if hasOwnLimit {
		return "Limit erreicht"
	}
	if bestPos > 0 {
		return fmt.Sprintf("Wartet (%d)", bestPos)
	}

	return "Suche..."
}

func dlStatusClass(d domain.Download) string {
	switch d.Status {
	case domain.DownloadPaused:
		return "text-text-muted"
	case domain.DownloadFinishing, domain.DownloadCreatingData:
		return "text-status-warn"
	case domain.DownloadFinished:
		return "text-status-ok"
	case domain.DownloadCanceled, domain.DownloadCanceling, domain.DownloadDiskFull, domain.DownloadFinishError:
		return "text-status-err"
	}
	
	hasTransferring := false
	hasOwnLimit := false
	for _, src := range d.Sources {
		if src.Status == domain.UserTransferring {
			hasTransferring = true
			break
		}
		if src.Status == domain.UserOwnLimit {
			hasOwnLimit = true
		}
	}

	if hasTransferring {
		return "text-status-ok"
	}
	if hasOwnLimit {
		return "text-status-err"
	}
	return "text-status-warn"
}

func countActiveSources(sources []domain.Source) int {
	count := 0
	for _, s := range sources {
		if s.Status == domain.UserTransferring {
			count++
		}
	}
	return count
}

func getBestQueuePosition(sources []domain.Source) int {
	best := 0
	for _, s := range sources {
		if s.Status == domain.UserInQueue && s.QueuePosition > 0 {
			if best == 0 || s.QueuePosition < best {
				best = s.QueuePosition
			}
		}
	}
	return best
}

func dlProgressBarClass(d domain.Download) string {
	switch d.Status {
	case domain.DownloadPaused:
		return "bg-gray-500"
	case domain.DownloadFinishing:
		return "bg-status-warn animate-pulse"
	case domain.DownloadDiskFull, domain.DownloadFinishError:
		return "bg-status-err"
	}
	return "bg-primary"
}

func formatETA(seconds int64) string {
	if seconds <= 0 {
		return "-"
	}
	if seconds < 60 {
		return fmt.Sprintf("%ds", seconds)
	}
	if seconds < 3600 {
		return fmt.Sprintf("%dm %ds", seconds/60, seconds%60)
	}
	return fmt.Sprintf("%dh %dm", seconds/3600, (seconds%3600)/60)
}

