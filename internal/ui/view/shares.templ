package view

import (
	"fmt"
	"github.com/applejuicenetz/ajnx/internal/domain"
)

templ SharesPage(activePage string, nickname string, shares []domain.Share, dirs []domain.ShareDir) {
	@Layout("Dateien", activePage, nickname) {
		<div class="space-y-8" x-data="{ tab: 'files', search: '' }">
			<!-- Header & Stats -->
			<div class="flex flex-col lg:flex-row lg:items-end justify-between gap-6">
				<div>
					<h2 class="text-3xl font-bold mb-2">Meine Dateien</h2>
					<p class="text-text-muted">Verwalte deine Freigaben und behalte den Überblick über deine geteilten Inhalte.</p>
				</div>
				
				<div class="flex gap-4">
					<div class="bg-surface border border-border px-6 py-4 rounded-2xl shadow-sm flex flex-col">
						<span class="text-xs font-bold uppercase text-text-muted tracking-widest mb-1">Dateien</span>
						<span class="text-2xl font-mono font-bold text-primary">{ fmt.Sprintf("%d", len(shares)) }</span>
					</div>
					<div class="bg-surface border border-border px-6 py-4 rounded-2xl shadow-sm flex flex-col">
						<span class="text-xs font-bold uppercase text-text-muted tracking-widest mb-1">Gesamtgröße</span>
						<span class="text-2xl font-mono font-bold text-primary">{ formatSize(calculateTotalSize(shares)) }</span>
					</div>
				</div>
			</div>

			<!-- Tabs -->
			<div class="flex border-b border-border gap-8">
				<button 
					@click="tab = 'files'"
					:class="tab === 'files' ? 'border-primary text-primary' : 'border-transparent text-text-muted hover:text-text-main'"
					class="pb-4 text-sm font-bold uppercase tracking-widest border-b-2 transition-all"
				>
					Gesharedte Dateien
				</button>
				<button 
					@click="tab = 'dirs'"
					:class="tab === 'dirs' ? 'border-primary text-primary' : 'border-transparent text-text-muted hover:text-text-main'"
					class="pb-4 text-sm font-bold uppercase tracking-widest border-b-2 transition-all"
				>
					Verzeichnisse
				</button>
			</div>

			<!-- Content: Files -->
			<div x-show="tab === 'files'" class="space-y-4" id="shares-files-container" hx-get="/shares" hx-trigger="refreshShares from:body" hx-select="#shares-files-container" hx-swap="outerHTML">
				<div class="flex items-center gap-4 bg-surface border border-border rounded-xl px-4 py-2 focus-within:border-primary transition-colors">
					<svg class="w-5 h-5 text-text-muted" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><circle cx="11" cy="11" r="8"/><path d="m21 21-4.3-4.3"/></svg>
					<input 
						type="text" 
						x-model="search" 
						placeholder="Dateien filtern..." 
						class="bg-transparent border-none outline-none w-full text-sm placeholder:text-text-muted/50"
					/>
				</div>

				<div class="bg-surface border border-border rounded-2xl overflow-hidden shadow-sm overflow-x-auto">
					<table class="w-full text-left border-collapse">
						<thead>
							<tr class="bg-background/50 border-b border-border">
								<th class="px-6 py-4 text-[11px] font-bold uppercase tracking-widest text-text-muted">Dateiname</th>
								<th class="px-6 py-4 text-[11px] font-bold uppercase tracking-widest text-text-muted">Größe</th>
								<th class="px-6 py-4 text-[11px] font-bold uppercase tracking-widest text-text-muted text-right">Priorität</th>
								<th class="px-6 py-4 text-[11px] font-bold uppercase tracking-widest text-text-muted text-right">Aktionen</th>
							</tr>
						</thead>
						<tbody class="divide-y divide-border/50">
							for _, s := range shares {
								<tr 
									x-show="search === '' || '{ s.Filename }'.toLowerCase().includes(search.toLowerCase())"
									class="hover:bg-white/[0.02] transition-colors group"
								>
									<td class="px-6 py-4">
										<div class="flex flex-col">
											<span class="text-sm font-medium text-text-main group-hover:text-primary transition-colors truncate max-w-md">{ s.Filename }</span>
											<span class="text-[10px] font-mono text-text-muted mt-0.5">{ s.Hash }</span>
										</div>
									</td>
									<td class="px-6 py-4">
										<span class="text-sm font-mono text-text-muted">{ formatSize(s.Size) }</span>
									</td>
									<td class="px-6 py-4 text-right">
										<span class="inline-flex items-center px-2 py-0.5 rounded text-[10px] font-bold bg-primary/10 text-primary border border-primary/20">
											Prio { fmt.Sprintf("%d", s.Priority) }
										</span>
									</td>
									<td class="px-6 py-4 text-right">
										<button class="p-2 text-text-muted hover:text-primary transition-colors">
											<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
										</button>
									</td>
								</tr>
							}
						</tbody>
					</table>
					if len(shares) == 0 {
						<div class="p-20 text-center">
							<div class="w-16 h-16 bg-primary/5 rounded-full flex items-center justify-center mx-auto mb-4 border border-primary/10">
								<svg class="w-8 h-8 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M7 21h10a2 2 0 0 0 2-2V9.414a1 1 0 0 0-.293-.707l-5.414-5.414A1 1 0 0 0 12.586 3H7a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2z"/></svg>
							</div>
							<h3 class="text-lg font-bold mb-1">Keine Dateien freigegeben</h3>
							<p class="text-text-muted text-sm">Füge Verzeichnisse hinzu, um Dateien mit dem Netzwerk zu teilen.</p>
						</div>
					}
				</div>
			</div>

			<!-- Content: Directories -->
			<div x-show="tab === 'dirs'" class="space-y-6" x-data="{ addingDir: false, newDirPath: '' }">
				<div class="flex justify-between items-center">
					<h3 class="text-xl font-bold">Freigegebene Verzeichnisse</h3>
					<button 
						@click="addingDir = !addingDir"
						class="bg-primary hover:bg-primary-hover text-white px-4 py-2 rounded-lg font-bold transition-all flex items-center gap-2 text-sm shadow-lg shadow-primary/20"
					>
						<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12h14"/></svg>
						Ordner hinzufügen
					</button>
				</div>

				<!-- Add Directory Inline Form -->
				<div x-show="addingDir" x-transition class="bg-surface border border-primary/30 p-6 rounded-2xl shadow-xl animate-in slide-in-from-top-4 duration-300">
					<h4 class="font-bold mb-4">Neues Verzeichnis freigeben</h4>
					<div class="flex flex-col sm:flex-row gap-4">
						<input 
							type="text" 
							x-model="newDirPath"
							placeholder="/pfad/zum/ordner"
							class="flex-1 bg-background border border-border rounded-xl px-4 py-2 focus:border-primary outline-none transition-all text-sm"
						/>
						<div class="flex gap-2">
							<button 
								@click="addingDir = false; newDirPath = ''"
								class="px-4 py-2 text-sm font-bold text-text-muted hover:text-text-main transition-colors"
							>
								Abbrechen
							</button>
							<button 
								class="bg-primary text-white px-6 py-2 rounded-lg font-bold text-sm shadow-lg shadow-primary/20 hover:scale-[1.02] active:scale-95 transition-all"
								hx-post="/shares/dirs/add"
								hx-ext="json-enc"
								:hx-vals="JSON.stringify({ path: newDirPath, withSubfolders: true })"
								hx-swap="none"
								@click="addingDir = false; newDirPath = ''"
							>
								Speichern
							</button>
						</div>
					</div>
				</div>

				<div class="grid grid-cols-1 gap-4" id="shares-dirs-list" hx-get="/shares" hx-trigger="refreshShares from:body" hx-select="#shares-dirs-list" hx-swap="outerHTML">
					for _, d := range dirs {
						<div class="bg-surface border border-border p-6 rounded-2xl shadow-sm hover:border-primary/30 transition-all group relative overflow-hidden">
							<div class="flex items-start justify-between relative z-10">
								<div class="flex items-center gap-4">
									<div class="w-12 h-12 bg-primary/5 rounded-xl flex items-center justify-center border border-primary/10">
										<svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-6l-2-2H5a2 2 0 0 0-2 2z"/></svg>
									</div>
									<div>
										<h4 class="font-bold text-text-main group-hover:text-primary transition-colors">{ d.Path }</h4>
										<div class="flex items-center gap-3 mt-1">
											if d.WithSubfolders {
												<span class="inline-flex items-center gap-1 text-[10px] font-bold uppercase text-primary tracking-wider">
													<svg class="w-3 h-3" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="m7 15 5 5 5-5M7 9l5-5 5 5"/></svg>
													Inkl. Unterordner
												</span>
											} else {
												<span class="text-[10px] font-bold uppercase text-text-muted tracking-wider">Nur dieser Ordner</span>
											}
										</div>
									</div>
								</div>
								
								<button 
									hx-post={ string(templ.SafeURL("/shares/dirs/remove?path=" + d.Path)) }
									hx-swap="none"
									hx-confirm="Freigabe wirklich entfernen?"
									class="p-2 text-text-muted hover:text-rose-400 transition-colors"
								>
									<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M3 6h18m-2 0v14a2 2 0 0 1-2 2H7a2 2 0 0 1-2-2V6m3 0V4a2 2 0 0 1 2-2h4a2 2 0 0 1 2 2v2"/></svg>
								</button>
							</div>
							<!-- Subtle background decoration -->
							<div class="absolute -right-4 -bottom-4 opacity-[0.02] group-hover:opacity-[0.05] transition-opacity">
								<svg width="120" height="120" fill="currentColor" viewBox="0 0 24 24"><path d="M3 7v10a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V9a2 2 0 0 0-2-2h-6l-2-2H5a2 2 0 0 0-2 2z"/></svg>
							</div>
						</div>
					}
					if len(dirs) == 0 {
						<div class="p-12 border-2 border-dashed border-border rounded-2xl text-center">
							<p class="text-text-muted text-sm">Du hast noch keine Verzeichnisse freigegeben.</p>
						</div>
					}
				</div>
			</div>
		</div>
	}
}

func calculateTotalSize(shares []domain.Share) int64 {
	var total int64
	for _, s := range shares {
		total += s.Size
	}
	return total
}
