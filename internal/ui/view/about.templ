package view

type VersionInfo struct {
	Current   string
	Latest    string
	IsUpdate  bool
}

templ AboutPage(v VersionInfo, nickname string) {
	@Layout("Über AJNX", "about", nickname) {
		<div class="max-w-4xl mx-auto space-y-12">
			<!-- Hero Section -->
			<div class="text-center space-y-6">
				<div class="inline-flex items-center justify-center w-24 h-24 rounded-3xl bg-primary/10 text-primary mb-2 shadow-xl shadow-primary/10">
					@Logo("w-12 h-14")
				</div>
				<h1 class="text-5xl font-black tracking-tight italic uppercase">
					appleJuice <span class="text-primary">NX</span>
				</h1>
				<p class="text-xl text-text-muted max-w-2xl mx-auto leading-relaxed">
					Die nächste Generation des appleJuice Managements. Schnell, sicher und plattformunabhängig.
				</p>
			</div>

			<!-- Version Status -->
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
				<div class="bg-surface border border-border rounded-2xl p-8 shadow-sm">
					<h2 class="text-xs font-bold uppercase tracking-widest text-text-muted mb-6">Software Status</h2>
					<div class="space-y-6">
						<div class="flex justify-between items-center">
							<span class="text-text-muted">Installierte Version</span>
							<span class="font-mono font-bold bg-background px-3 py-1 rounded-lg border border-border">{ v.Current }</span>
						</div>
						<div class="flex justify-between items-center">
							<span class="text-text-muted">Aktuellste Version (GitHub)</span>
							<span class="font-mono font-bold bg-background px-3 py-1 rounded-lg border border-border">{ v.Latest }</span>
						</div>
						
						if v.IsUpdate {
							<div class="mt-8 p-4 bg-status-ok/10 border border-status-ok/20 rounded-xl flex items-center gap-4 animate-pulse">
								<div class="p-2 bg-status-ok/20 rounded-lg text-status-ok">
									<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 5v14M5 12l7 7 7-7"/></svg>
								</div>
								<div>
									<p class="text-sm font-bold text-status-ok">Update verfügbar!</p>
									<p class="text-xs text-text-muted">Eine neue Version wurde auf GitHub veröffentlicht.</p>
								</div>
							</div>
						} else {
							<div class="mt-8 p-4 bg-background/50 border border-border rounded-xl flex items-center gap-4">
								<div class="p-2 bg-status-ok/20 rounded-lg text-status-ok">
									<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M20 6L9 17l-5-5"/></svg>
								</div>
								<p class="text-sm font-bold">Deine Version ist aktuell.</p>
							</div>
						}
					</div>
				</div>

				<div class="bg-surface border border-border rounded-2xl p-8 shadow-sm flex flex-col justify-between">
					<div>
						<h2 class="text-xs font-bold uppercase tracking-widest text-text-muted mb-6">Open Source</h2>
						<p class="text-sm leading-relaxed text-text-muted mb-6">
							AJNX ist freie Software und wird von der Community entwickelt. 
							Hilf mit, das appleJuice Netzwerk am Leben zu erhalten!
						</p>
					</div>
					<div class="flex flex-col gap-3">
						<a href="https://github.com/appleJuiceNetz/ajnx" target="_blank" class="flex items-center justify-center gap-2 bg-primary hover:bg-primary-hover text-background font-bold py-3 rounded-xl transition-all shadow-lg shadow-primary/20">
							<svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
							GitHub Repository
						</a>
						<a href="https://www.applejuice-board.de" target="_blank" class="flex items-center justify-center gap-2 bg-surface hover:bg-surface-hover border border-border font-bold py-3 rounded-xl transition-all">
							Community Forum
						</a>
					</div>
				</div>
			</div>

			<!-- Features / Credits -->
			<div class="grid grid-cols-1 sm:grid-cols-3 gap-8 pt-8">
				<div class="text-center space-y-3">
					<div class="text-primary font-black text-3xl italic">MODERN</div>
					<p class="text-xs text-text-muted uppercase tracking-widest font-bold">UI / UX Design</p>
				</div>
				<div class="text-center space-y-3">
					<div class="text-primary font-black text-3xl italic">FAST</div>
					<p class="text-xs text-text-muted uppercase tracking-widest font-bold">Go Backend</p>
				</div>
				<div class="text-center space-y-3">
					<div class="text-primary font-black text-3xl italic">SECURE</div>
					<p class="text-xs text-text-muted uppercase tracking-widest font-bold">Docker Native</p>
				</div>
			</div>

			<div class="text-center text-[10px] text-text-muted pt-12 uppercase tracking-[0.2em] font-black">
				Entwickelt mit ❤️ für das appleJuice Netzwerk
			</div>
		</div>
	}
}
