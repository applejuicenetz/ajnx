package view

// Logo rendert das aJnX-Markenzeichen: stilisierter Apfel mit Download-Pfeil.
// cssClass steuert Größe und ggf. Filter (z.B. "w-10 h-12" oder "w-32 h-36").
templ Logo(cssClass string) {
	<svg
		class={ cssClass }
		version="1.2"
		xmlns="http://www.w3.org/2000/svg"
		viewBox="0 0 512 512"
		fill="none"
		aria-hidden="true"
	>
		<defs>
			<clipPath clipPathUnits="userSpaceOnUse" id="logo-cp1">
				<path d="m110 0h292c61 0 110 49 110 110v292c0 61-49 110-110 110h-292c-61 0-110-49-110-110v-292c0-61 49-110 110-110z"/>
			</clipPath>
			<linearGradient id="logo-g1" x2="1" gradientUnits="userSpaceOnUse" gradientTransform="matrix(512,512,-512,512,0,0)">
				<stop offset="0" stop-color="#2a2f3a"/>
				<stop offset=".55" stop-color="#1a1d25"/>
				<stop offset="1" stop-color="#0e1117"/>
			</linearGradient>
			<linearGradient id="logo-g2" x2="1" gradientUnits="userSpaceOnUse" gradientTransform="matrix(92,51.613,-51.765,92.271,272,95.568)">
				<stop offset="0" stop-color="#a4e34a"/>
				<stop offset="1" stop-color="#5fa023"/>
			</linearGradient>
			<linearGradient id="logo-g3" x2="1" gradientUnits="userSpaceOnUse" gradientTransform="matrix(0,282.829,-281.082,0,115.459,153.171)">
				<stop offset="0" stop-color="#c6f06b"/>
				<stop offset=".55" stop-color="#a4e34a"/>
				<stop offset="1" stop-color="#76b82c"/>
			</linearGradient>
			<radialGradient id="logo-g4" cx="0" cy="0" r="1" gradientUnits="userSpaceOnUse" gradientTransform="matrix(16864.897,0,0,16864.897,19229.009,22213.857)">
				<stop offset="0" stop-color="#1a3010" stop-opacity="0"/>
				<stop offset="1" stop-color="#1a3010" stop-opacity=".55"/>
			</radialGradient>
		</defs>
		<g clip-path="url(#logo-cp1)">
			<path fill-rule="evenodd" fill="url(#logo-g1)" d="m0 0h512v512h-512z"/>
			<!-- Raster/Grid (dezent) -->
			<g style="opacity: 0.1">
				<path stroke="#8fd13b" stroke-width="0.8" d="m80 120h352M80 200h352M80 280h352M80 360h352M120 80v352M200 80v352M312 80v352M392 80v352"/>
			</g>
			<!-- Apple Shape -->
			<path fill="url(#logo-g3)" d="m254 170c-22-20-58-24-88-2-36 24-54 72-50 122 6 70 52 146 94 146 18 0 30-8 42-20 2-2 3-4 4-4 1 0 2 2 4 4 12 12 24 20 42 20 42 0 88-76 94-146 4-50-14-98-50-122-30-22-66-18-88 2-1 1-2 2-2 2 0 0-1-1-2-2z"/>
			<!-- Shadow/Inner Glow -->
			<path fill="url(#logo-g4)" d="m254 170c-22-20-58-24-88-2-36 24-54 72-50 122 6 70 52 146 94 146 18 0 30-8 42-20 2-2 3-4 4-4 1 0 2 2 4 4 12 12 24 20 42 20 42 0 88-76 94-146 4-50-14-98-50-122-30-22-66-18-88 2-1 1-2 2-2 2 0 0-1-1-2-2z"/>
			<!-- Leaf -->
			<path fill="url(#logo-g2)" d="m272 119c25-25 65-30 92-15-12 37-54 53-86 37-4-4-6-12-6-22z"/>
			<!-- The X / Download Indicator -->
			<path stroke="white" stroke-width="30" stroke-linecap="round" d="m206 246l100 100M306 246l-100 100" style="opacity: 0.9"/>
		</g>
		<path stroke="rgba(255,255,255,0.1)" stroke-width="1" fill="none" d="m110 0.5h292c60.7 0 109.5 48.8 109.5 109.5v292c0 60.7-48.8 109.5-109.5 109.5h-292c-60.7 0-109.5-48.8-109.5-109.5v-292c0-60.7 48.8-109.5 109.5-109.5z"/>
	</svg>
}
