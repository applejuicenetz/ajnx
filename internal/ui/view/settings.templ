package view

import (
	"fmt"
	"github.com/applejuicenetz/ajnx/internal/setup"
	"github.com/applejuicenetz/ajnx/internal/core"
)

// SettingsPage rendert die Einstellungsseite.
templ SettingsPage(activePage string, nickname string, lock setup.Lock, coreSettings core.XMLSettings) {
	@Layout("Einstellungen", activePage, nickname) {
		<div class="max-w-4xl mx-auto space-y-8">
			<div>
				<h2 class="text-3xl font-bold mb-2">Einstellungen</h2>
				<p class="text-text-muted">Konfiguriere dein AJNX Gateway und verwalte Erweiterungen.</p>
			</div>

			<!-- ─── Core Settings Section ─── -->

			<!-- ─── Core Settings Section ─── -->
			<div class="bg-surface border border-border rounded-2xl overflow-hidden shadow-sm">
				<div class="px-6 py-4 bg-background/50 border-b border-border flex items-center gap-3">
					<svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 20h9"/><path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/></svg>
					<h3 class="text-xl font-bold">Core Konfiguration</h3>
				</div>
				
				<form hx-post="/settings/core" hx-swap="none" hx-on::after-request="if(event.detail.successful) { alert('Einstellungen erfolgreich gespeichert!'); } else { alert('Fehler: ' + event.detail.xhr.responseText); }">
					<input type="hidden" name="port" value={ fmt.Sprintf("%d", coreSettings.Port) } />
					<input type="hidden" name="xml_port" value={ fmt.Sprintf("%d", coreSettings.XMLPort) } />
					<div class="p-6 space-y-6">
						<!-- Identität -->
						<div class="grid grid-cols-1 md:grid-cols-2 gap-6">
							<div>
								<label class="block text-xs font-bold uppercase text-text-muted mb-2 tracking-widest">Nickname</label>
								<input type="text" name="nickname" value={ coreSettings.Nick } class="w-full bg-background/50 border border-border rounded-lg px-4 py-2 focus:border-primary outline-none transition-colors" />
							</div>
							<div>
								<label class="block text-xs font-bold uppercase text-text-muted mb-2 tracking-widest">Core Host (Read-only)</label>
								<input type="text" value={ lock.CoreHost } class="w-full bg-background/30 border border-border rounded-lg px-4 py-2 opacity-50 cursor-not-allowed" disabled />
							</div>
						</div>

						<!-- Bandbreite & Limits -->
						<div class="pt-4 border-t border-border/50">
							<h4 class="text-sm font-bold text-primary mb-4 uppercase tracking-widest">Bandbreite & Limits</h4>
							<div class="grid grid-cols-1 md:grid-cols-3 gap-6">
								<div>
									<label class="block text-xs font-bold uppercase text-text-muted mb-2 tracking-widest">Max. Upload (KB/s)</label>
									<input type="number" name="max_upload" value={ fmt.Sprintf("%d", coreSettings.MaxUpload/1024) } class="w-full bg-background/50 border border-border rounded-lg px-4 py-2 focus:border-primary outline-none" />
								</div>
								<div>
									<label class="block text-xs font-bold uppercase text-text-muted mb-2 tracking-widest">Max. Download (KB/s)</label>
									<input type="number" name="max_download" value={ fmt.Sprintf("%d", coreSettings.MaxDownload/1024) } class="w-full bg-background/50 border border-border rounded-lg px-4 py-2 focus:border-primary outline-none" />
								</div>
								<div>
									<label class="block text-xs font-bold uppercase text-text-muted mb-2 tracking-widest">Speed pro Slot (KB/s)</label>
									<input type="number" name="speed_per_slot" value={ fmt.Sprintf("%d", coreSettings.SpeedPerSlot/1024) } class="w-full bg-background/50 border border-border rounded-lg px-4 py-2 focus:border-primary outline-none" />
								</div>
							</div>
						</div>

						<!-- Verbindungen -->
						<div class="grid grid-cols-1 md:grid-cols-3 gap-6 pt-2">
							<div>
								<label class="block text-xs font-bold uppercase text-text-muted mb-2 tracking-widest">Max. Verbindungen</label>
								<input type="number" name="max_connections" value={ fmt.Sprintf("%d", coreSettings.MaxConnections) } class="w-full bg-background/50 border border-border rounded-lg px-4 py-2 focus:border-primary outline-none" />
							</div>
							<div>
								<label class="block text-xs font-bold uppercase text-text-muted mb-2 tracking-widest">Quellen pro Datei</label>
								<input type="number" name="max_sources_per_file" value={ fmt.Sprintf("%d", coreSettings.MaxSourcesPerFile) } class="w-full bg-background/50 border border-border rounded-lg px-4 py-2 focus:border-primary outline-none" />
							</div>
							<div>
								<label class="block text-xs font-bold uppercase text-text-muted mb-2 tracking-widest">Auto-Connect</label>
								<select name="auto_connect" class="w-full bg-background/50 border border-border rounded-lg px-4 py-2 focus:border-primary outline-none appearance-none">
									<option value="True" if coreSettings.AutoConnect == "True" { selected }>Aktiviert</option>
									<option value="False" if coreSettings.AutoConnect == "False" { selected }>Deaktiviert</option>
								</select>
							</div>
						</div>

						<!-- Verzeichnisse -->
						<div class="pt-4 border-t border-border/50">
							<h4 class="text-sm font-bold text-primary mb-4 uppercase tracking-widest">Verzeichnisse</h4>
							<div class="space-y-4">
								<div>
									<label class="block text-xs font-bold uppercase text-text-muted mb-2 tracking-widest">Incoming (Fertige Dateien)</label>
									<input type="text" name="incoming_dir" value={ coreSettings.IncomingDir } class="w-full bg-background/50 border border-border rounded-lg px-4 py-2 focus:border-primary outline-none" />
								</div>
								<div>
									<label class="block text-xs font-bold uppercase text-text-muted mb-2 tracking-widest">Temporary (Laufende Downloads)</label>
									<input type="text" name="temp_dir" value={ coreSettings.TempDir } class="w-full bg-background/50 border border-border rounded-lg px-4 py-2 focus:border-primary outline-none" />
								</div>
							</div>
						</div>

						<div class="pt-6 flex justify-end">
							<button type="submit" class="bg-primary hover:bg-primary-hover text-white px-8 py-3 rounded-xl font-bold transition-all shadow-lg shadow-primary/20 active:scale-95 flex items-center gap-2">
								<svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>
								Einstellungen speichern
							</button>
						</div>
					</div>
				</form>
			</div>
			<!-- ─── Browser Integration ─── -->
			<div class="bg-surface border border-border rounded-2xl overflow-hidden shadow-sm">
				<div class="px-6 py-4 bg-background/50 border-b border-border flex items-center gap-3">
					<svg class="w-6 h-6 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71"/><path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71"/></svg>
					<h3 class="text-xl font-bold">Browser Integration</h3>
				</div>
				<div class="p-6 space-y-4">
					<p class="text-sm text-text-muted leading-relaxed">
						Registriere AJNX als Standard-Programm für appleJuice-Links (<code class="bg-background px-1.5 py-0.5 rounded text-primary">ajfsp://</code>). 
						Dies ermöglicht das Hinzufügen von Downloads mit einem Klick direkt aus deinem Browser.
					</p>
					<div class="flex items-center gap-4">
						<button 
							onclick="registerProtocol()" 
							class="bg-surface hover:bg-surface-hover border border-border px-6 py-3 rounded-xl font-bold transition-all flex items-center gap-2"
						>
							<svg class="w-5 h-5 text-primary" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
							Protokoll-Handler registrieren
						</button>
					</div>
					<script>
						function registerProtocol() {
							if ('registerProtocolHandler' in navigator) {
								const url = window.location.origin + '/links?link=%s';
								try {
									navigator.registerProtocolHandler("web+ajfsp", url, "AJNX Link Handler");
									showToast('Registrierungs-Anfrage gesendet. Bitte bestätige den Browser-Dialog.', 'success');
								} catch (e) {
									showToast('Fehler bei der Registrierung: ' + e.message, 'error');
								}
							} else {
								showToast('Dein Browser unterstützt keine Protokoll-Handler.', 'error');
							}
						}
					</script>
				</div>
			</div>
		</div>
	}
}

