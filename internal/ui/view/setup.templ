package view

import (
	"github.com/applejuicenetz/ajnx/internal/setup"
	"github.com/applejuicenetz/ajnx/internal/domain"
	"fmt"
)

// SetupPageLayout ist ein eigenständiges HTML-Dokument für den Setup-Wizard –
// kein Sidebar-Nav, kein Bottom-Nav. Desktop: 2-Spalten Split.
templ SetupPageLayout(title string, step int, totalSteps int) {
	<!DOCTYPE html>
	<html lang="de" class="dark">
		<head>
			<meta charset="UTF-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>{ title } – Setup – aJnX</title>
			<link rel="stylesheet" href="/static/tailwind.css"/>
			<link rel="manifest" href="/static/manifest.json"/>
			<link rel="icon" type="image/png" href="/static/icon.png"/>
			<link rel="shortcut icon" href="/static/icon.png"/>
			<link rel="apple-touch-icon" href="/static/icon.png"/>
			<meta name="theme-color" content="#a3e635"/>
			<script src="https://unpkg.com/htmx.org@1.9.12" defer></script>
		</head>
		<body class="bg-background text-text-main font-sans antialiased min-h-screen">
			<div class="min-h-screen lg:grid lg:grid-cols-2">
				<!-- ─── Links: Formular-Panel ─── -->
				<div class="flex flex-col items-center justify-center min-h-screen px-6 py-12 lg:px-16">
					<!-- Logo + Brand -->
					<div class="mb-8 flex flex-col items-center">
						<span class="text-primary">
							@Logo("w-12 h-12")
						</span>
						<span class="mt-3 text-2xl font-bold tracking-tight">aJnX</span>
						<span class="text-xs text-text-muted mt-1">appleJuice next eXperience</span>
					</div>

					<!-- Fortschrittsanzeige -->
					<div class="w-full max-w-md mb-6">
						<div class="flex justify-between text-xs text-text-muted mb-2 uppercase tracking-widest font-semibold">
							<span>Schritt { fmt.Sprint(step) } von { fmt.Sprint(totalSteps) }</span>
							<span>{ fmt.Sprint(step * 100 / totalSteps) }%</span>
						</div>
						<div class="h-1 bg-gray-700 rounded-full overflow-hidden">
							<div
								class="h-full bg-primary rounded-full transition-all duration-500"
								style={ fmt.Sprintf("width: %d%%", step*100/totalSteps) }
							></div>
						</div>
					</div>

					<!-- Formular-Card -->
					<div class="w-full max-w-md bg-surface rounded-xl border border-border p-8 shadow-2xl">
						{ children... }
					</div>
				</div>

				<!-- ─── Rechts: Brand-Panel (nur Desktop) ─── -->
				<div class="hidden lg:flex flex-col items-center justify-center bg-gray-950 relative overflow-hidden">
					<div class="absolute inset-0 flex items-center justify-center pointer-events-none">
						<div class="w-96 h-96 bg-primary rounded-full opacity-10 blur-3xl"></div>
					</div>
					<div class="relative z-10 flex flex-col items-center text-center px-12 space-y-6">
						<span class="text-primary [filter:drop-shadow(0_0_40px_rgba(124,179,66,0.45))]">
							@Logo("w-40 h-40")
						</span>
						<h2 class="text-5xl font-bold tracking-tight mt-2">Welcome to aJnX.</h2>
						<p class="text-text-muted text-lg leading-relaxed max-w-xs">
							Access your appleJuice Core<br>
							Seamless. Secure. Open Source.
						</p>
					</div>
					<p class="absolute bottom-6 right-8 text-xs text-text-muted">aJnX v{ domain.Version }</p>
				</div>
			</div>
		</body>
	</html>
}

// ─── Schritt 1: Willkommen ───────────────────────────────────────────────────

templ SetupStep1(state *setup.WizardState) {
	@SetupPageLayout("Willkommen", 1, 2) {
		<form action="/setup/welcome" method="POST" class="space-y-6">
			<div class="text-center space-y-2">
				<h2 class="text-2xl font-bold">Willkommen</h2>
				<p class="text-sm text-text-muted">aJnX hilft dir, dein appleJuice Netzwerk modern und sicher zu verwalten.</p>
			</div>
			<div>
				<label class="block text-xs font-bold uppercase tracking-wider text-text-muted mb-2">Sprache / Language</label>
				<select name="language" class="w-full bg-background border border-border rounded-lg px-4 py-3 focus:border-primary outline-none transition-colors">
					<option value="de" selected?={ state.Language == "de" }>Deutsch</option>
					<option value="en" selected?={ state.Language == "en" }>English</option>
				</select>
			</div>
			<button type="submit" class="btn-primary w-full py-3 text-base">Setup starten</button>
			<p class="text-xs text-center text-text-muted">Dauer: ca. 60 Sekunden</p>
		</form>
	}
}

// ─── Schritt 2: Core verbinden (kombiniert: Host + Port + Passwort + Live-Test) ──

templ SetupStep2(state *setup.WizardState, errorMsg string) {
	@SetupPageLayout("Core verbinden", 2, 2) {
		<form id="setup-core-form" action="/setup/core" method="POST" class="space-y-5">
			<div class="space-y-1">
				<h2 class="text-2xl font-bold">Core verbinden</h2>
				<p class="text-sm text-text-muted">Gib die Verbindungsdaten deines appleJuice Cores ein und teste die Verbindung.</p>
			</div>

			<!-- Fehler beim finalen Speichern -->
			if errorMsg != "" {
				<div class="rounded-lg bg-status-err/10 border border-status-err/30 px-4 py-3 text-sm text-status-err">
					{ errorMsg }
				</div>
			}

			<div class="space-y-4">
				<!-- Host -->
				<div>
					<label class="block text-xs font-bold uppercase tracking-wider text-text-muted mb-1.5">Host / IP</label>
					<input
						type="text"
						name="core_host"
						value={ state.CoreHost }
						placeholder="192.168.178.1"
						required
						hx-post="/setup/test-connection"
						hx-trigger="keyup changed delay:500ms"
						hx-target="#connection-status"
						hx-include="#setup-core-form"
						class="w-full bg-background border border-border rounded-lg px-4 py-3 focus:border-primary outline-none transition-colors text-sm"
					/>
				</div>

				<!-- Port -->
				<div>
					<label class="block text-xs font-bold uppercase tracking-wider text-text-muted mb-1.5">XML-Port</label>
					<input
						type="number"
						name="core_port"
						value={ state.CorePort }
						placeholder="9851"
						min="1"
						max="65535"
						required
						hx-post="/setup/test-connection"
						hx-trigger="keyup changed delay:500ms"
						hx-target="#connection-status"
						hx-include="#setup-core-form"
						class="w-full bg-background border border-border rounded-lg px-4 py-3 focus:border-primary outline-none transition-colors text-sm"
					/>
				</div>

				<!-- Passwort -->
				<div>
					<label class="block text-xs font-bold uppercase tracking-wider text-text-muted mb-1.5">Core-Passwort</label>
					<input
						type="password"
						name="core_password"
						placeholder="••••••••"
						required
						hx-post="/setup/test-connection"
						hx-trigger="keyup changed delay:500ms"
						hx-target="#connection-status"
						hx-include="#setup-core-form"
						class="w-full bg-background border border-border rounded-lg px-4 py-3 focus:border-primary outline-none transition-colors text-sm"
					/>
					<p class="mt-1.5 text-xs text-amber-400/80">
						Standard-Passwort <span class="font-mono bg-amber-900/20 px-1 rounded">applejuice</span>
					</p>
				</div>
			</div>

			<!-- Inline-Status (htmx-Ziel) -->
			<div id="connection-status" class="min-h-[40px]"></div>

			<!-- Setup abschließen – initial deaktiviert, wird per OOB-Swap aktiviert -->
			<div class="pt-1">
				<button
					id="btn-setup-finish"
					type="submit"
					disabled
					class="w-full py-3 rounded-lg bg-border text-text-muted cursor-not-allowed font-semibold text-sm transition-colors"
				>
					Setup abschließen
				</button>
			</div>
		</form>
	}
}

// ─── htmx-Fragment: Verbindungstest-Ergebnis ────────────────────────────────
// Wird von /setup/test-connection zurückgegeben und in #connection-status eingefügt.
// Enthält gleichzeitig einen OOB-Swap für den Submit-Button.

templ SetupTestResult(success bool, message, detail string) {
	<!-- Primärer Swap: Status-Anzeige -->
	if success {
		<div class="rounded-lg bg-status-ok/10 border border-status-ok/30 px-4 py-3">
			<div class="flex items-start gap-2.5">
				<svg class="w-4 h-4 text-status-ok mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"></path>
				</svg>
				<div>
					<p class="text-sm font-medium text-status-ok">{ message }</p>
					if detail != "" {
						<p class="text-xs text-status-ok/70 mt-0.5 font-mono">{ detail }</p>
					}
				</div>
			</div>
		</div>
	} else {
		<div class="rounded-lg bg-status-err/10 border border-status-err/30 px-4 py-3">
			<div class="flex items-start gap-2.5">
				<svg class="w-4 h-4 text-status-err mt-0.5 shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
					<path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12"></path>
				</svg>
				<div>
					<p class="text-sm font-medium text-status-err">{ message }</p>
					if detail != "" {
						<p class="text-xs text-status-err/70 mt-0.5">{ detail }</p>
					}
				</div>
			</div>
		</div>
	}
	<!-- OOB-Swap: Submit-Button aktivieren/deaktivieren -->
	if success {
		<button
			id="btn-setup-finish"
			type="submit"
			form="setup-core-form"
			hx-swap-oob="outerHTML:#btn-setup-finish"
			class="w-full py-3 rounded-lg bg-primary text-white font-semibold text-sm hover:bg-primary/90 transition-colors"
		>
			Setup abschließen
		</button>
	} else {
		<button
			id="btn-setup-finish"
			type="submit"
			disabled
			hx-swap-oob="outerHTML:#btn-setup-finish"
			class="w-full py-3 rounded-lg bg-border text-text-muted cursor-not-allowed font-semibold text-sm transition-colors"
		>
			Setup abschließen
		</button>
	}
}
