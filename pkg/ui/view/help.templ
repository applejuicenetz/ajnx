package view

templ HelpPage(nickname string) {
	@Layout("Hilfe & FAQ", "help", nickname) {
		<div class="max-w-4xl mx-auto space-y-8">
			<div class="mb-12">
				<h1 class="text-3xl font-black italic uppercase tracking-tight mb-2">Hilfe & <span class="text-primary">FAQ</span></h1>
				<p class="text-text-muted leading-relaxed">Hier findest du Antworten auf die häufigsten Fragen rund um appleJuice und aJnX.</p>
			</div>

			<div class="grid grid-cols-1 gap-4">
				@faqItem("Was ist der Unterschied zwischen HighID und LowID?") {
					<p>Eine <strong>HighID</strong> bedeutet, dass dein appleJuice Core von außen direkt erreichbar ist (Port-Forwarding aktiv). Das ermöglicht schnellere Verbindungen zu anderen Clients. Eine <strong>LowID</strong> (Firewalled) bedeutet, dass du hinter einem Router oder einer Firewall sitzt, die den Port blockiert. Du kannst zwar laden, bist aber in der Quellensuche eingeschränkt.</p>
				}
				
				@faqItem("Wie füge ich einen appleJuice Link hinzu?") {
					<p>Kopiere einfach einen Link im Format <code class="bg-background px-1.5 py-0.5 rounded text-primary">ajfsp://...</code> und füge ihn oben in die Suchleiste im Header ein. Drücke Enter, und der Download wird sofort gestartet. Alternativ kannst du auf der Download-Seite auf "Link hinzufügen" klicken.</p>
				}

				@faqItem("Warum steigen meine Credits nicht?") {
					<p>Credits erhältst du, indem du Dateien für andere Benutzer zum Upload bereitstellst. Je mehr du hochlädst, desto mehr Credits sammelst du. Diese Credits ermöglichen es dir, in den Warteschlangen anderer Benutzer schneller nach vorne zu rücken.</p>
				}

				@faqItem("Was bedeutet 'Core beenden' im Header?") {
					<p>Dieser Button sendet einen Befehl an den appleJuice Core, sich sicher herunterzufahren. Dies ist nützlich, wenn du den Core auf einem Server betreibst und ihn ferngesteuert stoppen möchtest, ohne SSH-Zugriff zu nutzen.</p>
				}

				@faqItem("Wie funktioniert die Suche?") {
					<p>Gib einen Suchbegriff in die Suchleiste ein. aJnX fragt alle verbundenen Server nach Dateien ab, die deinem Suchbegriff entsprechen. In den Suchergebnissen kannst du die gewünschte Datei auswählen und den Download starten.</p>
				}
			</div>

			<div class="mt-12 p-8 bg-surface border border-border rounded-2xl text-center shadow-sm">
				<h3 class="font-bold mb-2">Noch Fragen?</h3>
				<p class="text-sm text-text-muted mb-6">Besuche das offizielle appleJuice Forum für tiefergehende technische Hilfe.</p>
				<a href="https://discord.gg/applejuice" target="_blank" class="inline-flex items-center gap-2 text-primary hover:underline font-bold">
					Zum Discord gehen
					<svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M10 6H6a2 2 0 0 0-2 2v10a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2v-4M14 4h6v6M10 14L20 4"/></svg>
				</a>
			</div>
		</div>
	}
}

templ faqItem(question string) {
	<div x-data="{ open: false }" class="bg-surface border border-border rounded-xl overflow-hidden transition-all duration-300" :class="open ? 'ring-1 ring-primary/30 border-primary/30 shadow-lg' : ''">
		<button 
			@click="open = !open" 
			class="w-full px-6 py-4 flex items-center justify-between text-left hover:bg-white/5 transition-colors"
		>
			<span class="font-bold">{ question }</span>
			<svg 
				class="w-5 h-5 text-text-muted transition-transform duration-300" 
				:class="open ? 'rotate-180 text-primary' : ''" 
				fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"
			>
				<polyline points="6 9 12 15 18 9"/>
			</svg>
		</button>
		<div 
			x-show="open" 
			x-collapse
			x-transition:enter="transition ease-out duration-300"
			x-transition:enter-start="opacity-0 -translate-y-2"
			x-transition:enter-end="opacity-100 translate-y-0"
			class="px-6 pb-6 text-sm text-text-muted leading-relaxed"
		>
			{ children... }
		</div>
	</div>
}
